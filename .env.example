# Copy to `.env` next to manage.py and fill in. Never commit the real file.
# Real environment variables take precedence over values set here.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Leave False in production. Defaults to False, so an incomplete .env fails
# closed rather than serving debug pages with stack traces and a settings dump.
DEBUG=False

# Required when DEBUG=False -- the app refuses to start without it.
# Generate:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Master key-encryption-key for note content. REQUIRED in every environment;
# there is no default and the app will not start without it.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: losing this key makes every note permanently unreadable. Back it up
# somewhere separate from the database -- a backup of the database alone is
# useless without it.
#
# WARNING: to change it, run `manage.py rotate_kek <new_key>` FIRST, while this
# variable still holds the OLD key, and only then edit this file. Doing it in
# the other order makes every wrapped key unreadable.
NOTES_KEK=

# Comma-separated. Must include the real domain in production.
ALLOWED_HOSTS=notes.example.com

# Comma-separated, scheme included. Required for POSTs over HTTPS.
CSRF_TRUSTED_ORIGINS=https://notes.example.com

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public /accounts/register/ form. Off means accounts are provisioned with
# `createsuperuser` or through the admin.
ACCOUNT_SIGNUP_ENABLED=False

# Where the Django admin is mounted; must end with a slash. Moving it off
# /admin/ is obscurity rather than security, but it drops essentially all
# drive-by bot probing from the logs.
ADMIN_URL=admin/

# Version history: a note keeps at most NOTE_REVISION_LIMIT past versions,
# saved at most once per NOTE_REVISION_WINDOW_MINUTES while editing.
NOTE_REVISION_LIMIT=50
NOTE_REVISION_WINDOW_MINUTES=10

# Absolute path to the SQLite file. Defaults to db.sqlite3 beside manage.py.
# The DIRECTORY must be writable by the service user: WAL mode creates
# `-wal` and `-shm` sidecar files next to the database. Must be local disk --
# WAL does not work over NFS/SMB.
# DATABASE_PATH=/home/deploy/web/notebooks/db.sqlite3

# DEBUG, INFO, WARNING, ERROR. Logs go to stdout, captured by journald.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# HTTPS
#
# These default to the right thing based on DEBUG, so in a normal TLS
# deployment you can leave them unset. Override only when serving over plain
# HTTP on purpose (a private network, or a local production-settings test run).
# ---------------------------------------------------------------------------

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# HSTS. Leave at 0 until the certificate is confirmed working, then set
# 31536000. Browsers cache the directive for its full duration, so publishing
# it with a broken certificate locks visitors out of the domain for a year.
SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
