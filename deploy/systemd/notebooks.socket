# Install to /etc/systemd/system/notebooks.socket
#
# systemd owns the unix socket rather than gunicorn. That is the whole point:
# it can hand the socket to gunicorn (running as `deploy`) while giving nginx
# (running as `www-data`) group access to it, so neither user has to be added
# to the other's group.
#
# Substitute `deploy` if your service user differs.

[Unit]
Description=Notebooks gunicorn socket

[Socket]
ListenStream=/run/notebooks/gunicorn.sock
SocketUser=deploy
SocketGroup=www-data
SocketMode=0660

[Install]
WantedBy=sockets.target
